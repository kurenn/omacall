#!/usr/bin/env bash

# omarchy:summary=Peer-to-peer video call another machine, no account or server.
# omarchy:args=[peer] | --setup | --announce | --answer <caller-ip> <caller-name> | --selftest

set -euo pipefail

OS=$(uname -s)
[[ $OS == Darwin ]] && PATH=/opt/homebrew/bin:$PATH

# Tuning knobs -- cameras and links differ, so these are meant to be turned.
CAM=${OMACALL_CAM:-/dev/video0}
RES=${OMACALL_RES:-1280x720}
BITRATE=${OMACALL_BITRATE:-2000000}
VPORT=${OMACALL_VPORT:-5000}
APORT=${OMACALL_APORT:-5002}
RING_TIMEOUT=${OMACALL_RING_TIMEOUT:-45}
CONTACTS=${OMACALL_CONTACTS:-$HOME/.config/omacall/contacts}
# Ports the daemon's tunnel delivers inbound media to. Zero for a loopback
# selftest, where send and receive must meet on the same port.
RECV_OFFSET=${OMACALL_RECV_OFFSET:-4}

if [[ $OS == Darwin ]]; then
  VIDEO_SRC=${OMACALL_VIDEO_SRC:-avfvideosrc device-index=0}
  AUDIO_SRC=${OMACALL_AUDIO_SRC:-osxaudiosrc}
else
  VIDEO_SRC=${OMACALL_VIDEO_SRC:-v4l2src device=$CAM}
  AUDIO_SRC=${OMACALL_AUDIO_SRC:-pipewiresrc}
fi

PREVIEW_SINK=${OMACALL_PREVIEW_SINK:-autovideosink}

VCAPS="application/x-rtp,media=(string)video,encoding-name=(string)VP8,payload=(int)96"
ACAPS="application/x-rtp,media=(string)audio,encoding-name=(string)OPUS,payload=(int)97,clock-rate=(int)48000,encoding-params=(string)2"

# $VIDEO_SRC and $AUDIO_SRC are deliberately unquoted: they are gstreamer
# element descriptions that need to word-split into separate arguments.
# ponytail: no echo cancellation -- wear headphones, or load pipewire's
# module-echo-cancel if open speakers turn out to matter.
send() {
  local host=$1
  # exec: so $! is gst-launch itself, not a subshell that orphans it
  exec gst-launch-1.0 -q \
    $VIDEO_SRC ! videoconvert ! videoscale \
    ! "video/x-raw,width=${RES%x*},height=${RES#*x}" ! tee name=cam \
    cam. ! queue leaky=downstream max-size-buffers=3 \
    ! vp8enc deadline=1 target-bitrate="$BITRATE" keyframe-max-dist=15 error-resilient=1 \
    ! rtpvp8pay pt=96 mtu=1120 ! udpsink host="$host" port="$VPORT" sync=false \
    cam. ! queue leaky=downstream max-size-buffers=3 \
    ! videoconvert ! $PREVIEW_SINK sync=false \
    $AUDIO_SRC ! audioconvert ! audioresample ! opusenc \
    ! rtpopuspay pt=97 mtu=1120 ! udpsink host="$host" port="$APORT" sync=false
}

recv() {
  # exec: so $! is gst-launch itself, not a subshell that orphans it
  exec gst-launch-1.0 -q \
    udpsrc port="$((VPORT + RECV_OFFSET))" caps="$VCAPS" ! rtpjitterbuffer latency=120 do-lost=true \
    ! rtpvp8depay ! vp8dec ! videoconvert ! autovideosink sync=false \
    udpsrc port="$((APORT + RECV_OFFSET))" caps="$ACAPS" ! rtpjitterbuffer latency=120 \
    ! rtpopusdepay ! opusdec ! audioconvert ! audioresample ! autoaudiosink sync=false
}

ui_notify() {
  if [[ $OS == Darwin ]]; then
    osascript -e "display notification \"$2\" with title \"$1\"" >/dev/null 2>&1 || true
  else
    notify-send -u critical -a "Call" "$1" "$2" || true
  fi
}

# Answer or decline, in whatever passes for a dialog on this machine.
ui_confirm() {
  if [[ $OS == Darwin ]]; then
    osascript -e "display dialog \"$1\" buttons {\"Decline\", \"Answer\"} \
      default button \"Answer\" giving up after $RING_TIMEOUT" 2>/dev/null |
      grep -q "button returned:Answer"
    return
  fi

  # Omarchy has no blocking dialog, so the floating terminal reports back
  # through a file that we poll until the ring times out.
  local verdict reply
  verdict=$(mktemp)
  omarchy-launch-floating-terminal-with-presentation \
    "gum confirm '$1' && echo yes >'$verdict' || echo no >'$verdict'"

  for ((i = 0; i < RING_TIMEOUT; i++)); do
    [[ -s $verdict ]] && break
    sleep 1
  done

  reply=$(cat "$verdict" 2>/dev/null || true)
  rm -f "$verdict"
  [[ $reply == yes ]]
}

# Both ends run the same thing: closing the video window ends the call.
talk() {
  local peer_ip=$1 peer_name=$2 r s
  ui_notify "In call with $peer_name" "Close the video window to hang up."
  echo "Your own camera opens right away. $peer_name's video appears once they connect."
  echo "Close a video window to hang up."
  recv & r=$!
  send "$peer_ip" & s=$!
  trap "kill $r $s 2>/dev/null" EXIT
  # Not `wait -n`: macOS still ships bash 3.2, which does not have it.
  while kill -0 "$r" 2>/dev/null && kill -0 "$s" 2>/dev/null; do sleep 1; done
}

# Callee side, invoked over ssh, so it has no graphical environment of its own.
answer() {
  local caller_ip=$1 caller_name=${2:-someone}

  if [[ $OS != Darwin ]]; then
    eval "$(systemctl --user show-environment 2>/dev/null | sed 's/^/export /')" || true
    : "${WAYLAND_DISPLAY:?no graphical session to ring}"
  fi

  ui_notify "Incoming call" "$caller_name is calling."

  if ui_confirm "Incoming call from $caller_name. Answer?"; then
    local detach=setsid
    command -v setsid >/dev/null || detach=nohup # macOS has no setsid
    $detach bash -c "$(printf '%q' "$0") --talk $(printf '%q' "$caller_ip") $(printf '%q' "$caller_name")" \
      >/dev/null 2>&1 &
    exit 0
  fi
  exit 1
}

# Any source that yields "name<TAB>address" will do. mDNS needs no setup at all,
# Tailscale is used only if it happens to be running, and the contacts file
# covers everyone else -- one line of "name host-or-ip".
peers() {
  {
    if command -v avahi-browse >/dev/null; then
      avahi-browse -tprk _omacall._udp 2>/dev/null |
        awk -F';' '$1 == "=" && $3 == "IPv4" { sub(/\.local$/, "", $7); print $7 "\t" $8 }'
    fi

    if command -v tailscale >/dev/null && tailscale status >/dev/null 2>&1; then
      tailscale status --json |
        jq -r '.Peer[]? | select(.Online == true and (.Tags | not)) | "\(.HostName)\t\(.TailscaleIPs[0])"'
    fi

    sed -E 's/#.*//; /^[[:space:]]*$/d; s/[[:space:]]+/\t/' "$CONTACTS" 2>/dev/null
  } |
    # A machine usually answers to several addresses. Prefer the LAN, then the
    # VPN, then whatever is left, and never offer ourselves.
    # ponytail: 172.16/12 is dropped wholesale because that is where Docker
    # puts its bridges; put it back if you ever run a LAN in that range.
    awk -F'\t' -v me="$(hostname -s 2>/dev/null || hostname)" '
      $2 ~ /^(127\.|172\.(1[6-9]|2[0-9]|3[01])\.)/ { next }
      $1 == me { next }
      { rank = 3
        if ($2 ~ /^(192\.168\.|10\.)/) rank = 1
        else if ($2 ~ /^100\./) rank = 2
        print rank "\t" $1 "\t" $2 }' |
    sort -t"$(printf '\t')" -k1,1n |
    awk -F'\t' '!seen[$2]++ { print $2 "\t" $3 }'
}

# Publish ourselves on the LAN so other machines see us with no configuration.
announce() {
  if [[ $OS == Darwin ]]; then
    exec dns-sd -R "$(hostname -s)" _omacall._udp . "$VPORT"
  fi
  exec avahi-publish -s "$(hostname)" _omacall._udp "$VPORT"
}

call() {
  local peer=${1:-} table name addr
  table=$(peers)

  if [[ -n $peer ]]; then
    addr=$(awk -F'\t' -v p="$peer" '$1 == p { print $2; exit }' <<<"$table")
    addr=${addr:-$peer} # fall back to treating the argument as a host or IP
    name=$peer
  else
    [[ -n $table ]] || { echo "No machines found. Add one to $CONTACTS, or pass a host."; exit 1; }
    name=$(cut -f1 <<<"$table" | gum choose --header "Call which machine?")
    [[ -n $name ]] || exit 0
    addr=$(awk -F'\t' -v p="$name" '$1 == p { print $2; exit }' <<<"$table")
  fi

  echo "Ringing $name..."
  # sshd hands the callee our address in SSH_CLIENT, so neither end needs to
  # know how the other one reached it -- LAN, VPN or plain internet.
  # A non-interactive ssh session gets a bare PATH, so spell out where the
  # command lives rather than relying on the callee's login shell.
  if ssh -o BatchMode=yes -o ConnectTimeout=10 "$addr" \
       "PATH=\$HOME/.local/bin:/opt/homebrew/bin:\$PATH \
        omacall --answer \${SSH_CLIENT%% *} $(hostname -s 2>/dev/null || hostname)"; then
    talk "$addr" "$name"
  else
    echo "$name did not pick up."
    exit 1
  fi
}

# Everything a fresh machine needs. The firewall step matters most: without it
# the call fails completely silently -- packets are dropped before the socket,
# so the receiver looks healthy and simply never sees a frame.
setup() {
  local desktop=$HOME/.local/share/applications/Omacall.desktop
  local unit=$HOME/.config/systemd/user/omacall-announce.service

  if [[ $OS == Darwin ]]; then
    echo "macOS: grant Camera and Microphone to the terminal you run this from"
    echo "(System Settings > Privacy & Security). Nothing else to set up."
    return
  fi

  mkdir -p "$(dirname "$desktop")" "$(dirname "$unit")" "$(dirname "$CONTACTS")"

  cat >"$desktop" <<EOF
[Desktop Entry]
Version=1.0
Name=Omacall
Comment=Peer-to-peer video call another machine
Exec=omarchy-launch-floating-terminal-with-presentation omacall
Terminal=false
Type=Application
Icon=camera-video
StartupNotify=true
EOF

  cat >"$unit" <<EOF
[Unit]
Description=Announce this machine for omacall on the LAN
After=avahi-daemon.service

[Service]
ExecStart=%h/.local/bin/omacall --announce
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
EOF

  [[ -f $CONTACTS ]] || printf '# name        host-or-ip\n' >"$CONTACTS"

  systemctl --user daemon-reload
  systemctl --user enable --now omacall-announce.service
  echo "Launcher entry and LAN announcement installed."

  # Derive the LAN from the default route rather than hardcoding a subnet.
  local iface cidr
  iface=$(ip -4 route show default 2>/dev/null | awk '{print $5; exit}')
  cidr=$(ip -4 route show dev "$iface" proto kernel scope link 2>/dev/null | awk '{print $1; exit}')

  if systemctl is-active --quiet ufw 2>/dev/null; then
    local rule="ufw allow proto udp from ${cidr:-192.168.0.0/16} to any port $VPORT:$APORT"
    echo "ufw is active -- opening UDP $VPORT-$APORT for $cidr"
    if ! sudo $rule; then
      echo
      echo "Could not add the rule (sudo needs a real terminal). Run this yourself:"
      echo "  sudo $rule"
      [[ -n $(command -v tailscale) ]] &&
        echo "  sudo ufw allow proto udp from 100.64.0.0/10 to any port $VPORT:$APORT"
    fi
  fi
}

# Loopback check: if media survives a round trip to 127.0.0.1, the pipelines work.
selftest() {
  local s
  PREVIEW_SINK=fakesink # keep the check headless
  RECV_OFFSET=0         # no tunnel in a loopback check
  send 127.0.0.1 >/dev/null 2>&1 & s=$!
  trap "kill $s 2>/dev/null" EXIT
  local timeout_cmd
  timeout_cmd=$(command -v timeout || command -v gtimeout) # macOS needs coreutils
  if "$timeout_cmd" 25 gst-launch-1.0 -q \
       udpsrc port="$((VPORT + RECV_OFFSET))" caps="$VCAPS" ! rtpjitterbuffer latency=120 \
       ! rtpvp8depay ! vp8dec ! fakesink num-buffers=15; then
    echo "selftest: OK -- ${OMACALL_VIDEO_SRC:-camera}, encoder and RTP transport all work"
  else
    echo "selftest: FAILED -- no frames made the round trip"
    # V4L2 allows a single opener, so a call in progress owns the camera.
    # Exclude our own sender, or the check reports itself as the culprit.
    [[ $OS != Darwin ]] && pgrep -x gst-launch-1.0 | grep -qv "^${s}$" &&
      echo "  a call is already running and holds the camera; hang up first"
    # A TCC denial looks exactly like a working pipeline that produces nothing,
    # and the grant belongs to the terminal, not to this script.
    [[ $OS == Darwin ]] && echo "  on macOS this is usually the camera being blocked:" \
      "run it from a terminal that has Camera and Microphone access" \
      "(System Settings > Privacy & Security), not Terminal.app"
    exit 1
  fi
}

case ${1:-} in
--answer) shift; answer "$@" ;;
--talk) shift; talk "$@" ;;
--announce) announce ;;
--setup) setup ;;
--selftest) selftest ;;
*) call "${1:-}" ;;
esac
